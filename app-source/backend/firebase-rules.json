{
  "rules": {
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'base', 'hat', 'eyes', 'aura', 'frame', 'updatedAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "base": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "hat": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "eyes": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "aura": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "frame": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['studying', 'ts'])",
        "studying": { ".validate": "newData.isBoolean()" },
        "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    }
  }
}
